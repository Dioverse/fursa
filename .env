# API Configuration
VITE_API_BASE_URL=https://back.fursaenergy.com/public/api

# Application Configuration
VITE_APP_NAME="Fursa Energy Admin"
VITE_APP_VERSION=1.0.0
DEV=0

# Upload Configuration
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx
FILE_BASE_PATH=https://back.fursaenergy.com/storage/

# Frontend-exposed base URL for files (used by image URL helper)
# Prefer no trailing slash and no /storage segment here; helper adds /storage when needed
VITE_FILES_BASE_URL=https://back.fursaenergy.com/public
# Optional alternative variable name supported by helper
# VITE_FILE_BASE_URL=https://back.fursaenergy.com

# Pagination
VITE_DEFAULT_PAGE_SIZE=10
VITE_MAX_PAGE_SIZE=100